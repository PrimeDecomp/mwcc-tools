#define BUILD_STRING L"4.0.0\0"
#else
#define BUILD 108
#define BUILD_STRING L"2.4.7.108\0"
#endif
#ifndef PATCH
#define PATCH 7
#endif

1 VERSIONINFO MOVEABLE PURE DISCARDABLE
#if VERSION == VERSION_WII_1_0RC1
FILEVERSION 4,2,PATCH,BUILD
PRODUCTVERSION 4,2,PATCH,BUILD
#else
FILEVERSION 2,4,PATCH,BUILD
PRODUCTVERSION 2,4,PATCH,BUILD
#endif
FILEFLAGSMASK 0x3f
FILEFLAGS 0
FILEOS 0x40004
FILETYPE 2
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
#if VERSION == VERSION_WII_1_0RC1
            VALUE "CompanyName", L"Freescale Semiconductor, Inc.\0"
            VALUE "FileDescription", L"CodeWarrior PPC EABI C/C++ Compiler\0"
